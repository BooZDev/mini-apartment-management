# =====================================================================
# Biến môi trường. Chép thành .env (đã có trong .gitignore) rồi điền.
# Thiếu hoặc sai biến nào thì app không khởi động, kèm tên biến
# (src/config/env.validation.ts). Biến để trống coi như chưa đặt.
# =====================================================================

# NODE_ENV=development
# PORT=3001

# ---------------------------------------------------------------------
# PostgreSQL (Supabase)
# ---------------------------------------------------------------------
# Lấy ở Supabase: Project Settings > Database > Connection string.
# Mật khẩu có ký tự đặc biệt thì mã hóa URL: @ -> %40, # -> %23, / -> %2F
#   cloud : postgresql://postgres.<project-ref>:<mat-khau>@aws-0-<region>.pooler.supabase.com:5432/postgres
#   máy   : pnpm db:test, rồi dùng postgresql://postgres:postgres@127.0.0.1:54329/postgres
DATABASE_URL=

# true: bắt buộc TLS (Supabase cloud) | false: tắt (CSDL trên máy) | để trống: theo chuỗi kết nối
# DATABASE_SSL=true
# Chứng chỉ CA của Supabase (Project Settings > Database > SSL), dán nội dung PEM.
# Có biến này thì chứng chỉ máy chủ CSDL được kiểm tra, chặn giả mạo máy chủ.
# DATABASE_SSL_CA=

# Số kết nối tối đa. Với CSDL thử (pnpm db:test) đặt 1
# DATABASE_POOL_MAX=10

# ---------------------------------------------------------------------
# Phiên đăng nhập
# ---------------------------------------------------------------------
# Khóa ký phiên, tối thiểu 32 ký tự ngẫu nhiên. Sinh bằng:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Đổi khóa thì mọi phiên đang mở hết hiệu lực.
JWT_SECRET=

# Cookie Secure (chỉ gửi qua HTTPS). Chỉ đặt false khi chạy http://localhost
# COOKIE_SECURE=true

# Số tầng proxy đứng trước API (Nginx, Cloudflare...). Sai số này thì giới hạn
# số lần thử đếm theo IP của proxy thay vì IP thật của người dùng
# TRUST_PROXY=0

# ---------------------------------------------------------------------
# CORS, Swagger
# ---------------------------------------------------------------------
# Địa chỉ ứng dụng Next.js, cách nhau bằng dấu phẩy. Cũng là danh sách Origin
# hợp lệ của lớp chống giả mạo yêu cầu
# CORS_ORIGINS=http://localhost:3000

# Trang tài liệu /server-api: mặc định bật khi phát triển, tắt ở production
# SWAGGER=true

# Tác vụ hằng ngày 07:00 (thông báo sắp đến hạn, quá hạn; dọn phiên hết hạn). Chạy nhiều instance thì chỉ bật ở một instance
# SCHEDULER=true
